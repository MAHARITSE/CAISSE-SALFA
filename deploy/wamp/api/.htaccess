# CAISSE SALFA — dossiers internes de l'API
# Stratégie « deny all » : si un futur fichier est ajouté ici par erreur,
# il restera inaccessible tant que son accès n'est pas explicitly autorisé.
# Les seuls points d'entrée publics sont api/points/*.php.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
